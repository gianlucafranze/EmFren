@model EmFren.Models.User

<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Mi cuenta - EmFren</title>

    <link rel="stylesheet"
          href="~/css/MyAccount.css" />

</head>


<body>


    <!-- =========================================================
         HEADER
         ========================================================= -->

    <header class="header">

        <a class="home-link"
           href="@Url.Action("HomeBuyer", "Home")">

            ← Home

        </a>


        <div class="header-title">

            Mi cuenta

        </div>

    </header>



    <!-- =========================================================
         MAIN
         ========================================================= -->

    <main class="account-container">


        <div class="account-card">


            <h2>

                Editar mi cuenta

            </h2>


            <p class="description">

                Modifica tu nombre de usuario y correo electrónico.

            </p>



            <!-- SUCCESS MESSAGE -->

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="success-message">

                    @TempData["SuccessMessage"]

                </div>
            }



            <!-- VALIDATION SUMMARY -->

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>



            <!-- =================================================
                 FORM
                 ================================================= -->

            <form asp-controller="MyAccount"
                  asp-action="Edit"
                  method="post">

                @Html.AntiForgeryToken()



                <!-- USERNAME -->

                <div class="form-group">

                    <label for="Username">

                        Nombre de usuario

                    </label>


                    <input type="text"
                           id="Username"
                           name="username"
                           value="@Model.Username"
                           class="form-control"
                           maxlength="50"
                           required />


                    <span asp-validation-for="Username"
                          class="field-error">
                    </span>

                </div>



                <!-- EMAIL -->

                <div class="form-group">

                    <label for="Email">

                        Correo electrónico

                    </label>


                    <input type="email"
                           id="Email"
                           name="email"
                           value="@Model.Email"
                           class="form-control"
                           maxlength="100"
                           required />


                    <span asp-validation-for="Email"
                          class="field-error">
                    </span>

                </div>



                <!-- BUTTONS -->

                <div class="buttons">

                    <button type="submit"
                            class="save-button">

                        Guardar cambios

                    </button>

                </div>


            </form>


        </div>


    </main>


</body>

</html>