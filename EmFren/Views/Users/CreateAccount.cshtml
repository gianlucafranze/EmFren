@model EmFren.Models.RegisterUser

@{
    ViewData["Title"] = "Crear una cuenta";
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet"
          href="~/css/CreateAccount.css" />

    <title>EmFren | Crear una cuenta</title>

</head>


<body>

    <div class="container">


        <!-- BRAND -->

        <div class="brand">

            <h1>EmFren</h1>

            <p>
                Sistema de gestión empresarial
            </p>

        </div>


        <!-- REGISTER CARD -->

        <div class="card">

            <h2>
                Crear una cuenta
            </h2>

            <p class="description">
                Completa tus datos para crear tu cuenta en EmFren.
            </p>


            <form asp-controller="Users"
                  asp-action="CreateAccount"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- USERNAME -->

                <div class="form-group">

                    <label for="username">
                        Nombre de usuario
                    </label>

                    <input type="text"
                           id="username"
                           name="Username"
                           class="input"
                           placeholder="Ingresa tu nombre de usuario"
                           maxlength="50"
                           autocomplete="username"
                           required>

                </div>


                <!-- EMAIL -->

                <div class="form-group">

                    <label for="email">
                        Correo electrónico
                    </label>

                    <input type="email"
                           id="email"
                           name="Email"
                           class="input"
                           placeholder="ejemplo@correo.com"
                           maxlength="100"
                           autocomplete="email"
                           required>

                </div>


                <!-- PASSWORD -->

                <div class="form-group">

                    <label for="password">
                        Contraseña
                    </label>

                    <div class="password-wrapper">

                        <input type="password"
                               id="password"
                               name="Password"
                               class="input password-input"
                               placeholder="Crea una contraseña"
                               autocomplete="new-password"
                               required>

                        <button type="button"
                                class="show-password"
                                onclick="togglePassword('password', this)">
                            👁
                        </button>

                    </div>

                    <div class="password-help">
                        Utiliza una contraseña segura para proteger tu cuenta.
                    </div>

                </div>

                <!-- REGISTER -->

                <button type="submit"
                        class="register-button">
                    Crear cuenta
                </button>


            </form>


            <!-- LOGIN -->

            <div class="login-link">

                <span>
                    ¿Ya tienes una cuenta?
                </span>

                <a href="/Users/Login">
                    Login
                </a>

            </div>


        </div>

    </div>


    <script src="~/js/CreateAccount.js"></script>

</body>

</html>