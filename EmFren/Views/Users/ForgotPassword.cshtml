<!DOCTYPE html>

<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/ForgotPassword.css" />

    <title>Recuperar contraseña - EmFren</title>

</head>

<body>

    <div class="container">

        <div class="logo">
            <h1>EmFren</h1>
            <p>Gestión empresarial</p>
        </div>

        <div class="card">

            <div class="icon">
                🔐
            </div>

            <h2>¿Olvidaste tu contraseña?</h2>

            <p class="description">
                Ingresa el correo electrónico asociado a tu cuenta
                y te enviaremos un enlace para recuperar tu contraseña.
            </p>

            <form asp-controller="Users"
                  asp-action="ForgotPassword"
                  method="post">

                  @Html.AntiForgeryToken()

                <div class="form-group">
                    <label for="email">Correo electrónico</label>

                    <div class="input-wrapper">
                        <span class="input-icon">✉</span>

                        <input type="email"
                               id="email"
                               name="email"
                               placeholder="ejemplo@correo.com"
                               required
                               autocomplete="email">
                    </div>
                </div>

                <button type="submit" class="submit-button">
                    Enviar enlace de recuperación
                </button>

            </form>

            <div class="info">
                Por seguridad, el enlace de recuperación tendrá
                un tiempo de validez limitado.
            </div>

            <div class="back-login">
                <a href="/Users/Login">
                    ← Volver al inicio de sesión
                </a>
            </div>

        </div>

    </div>
</body>
</html>
